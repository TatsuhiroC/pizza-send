{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pizza-send-signal",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "signal.pizzasend.dpdns.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://pizzasend.dpdns.org,http://127.0.0.1:5173,http://localhost:5173",
    "MAX_SHARES_PER_DAY": "1000",
    "MAX_SHARES_PER_MINUTE": "60",
    "MAX_ACTIVE_SHARES": "128",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFVVgJeMjjFKXnVL"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "LIMITS",
        "class_name": "RateLimit"
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room",
        "RateLimit"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Admission"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "71001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "71002",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "71003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "HANDSHAKE_LIMITER",
      "namespace_id": "71004",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "AUTH_FAILURE_LIMITER",
      "namespace_id": "71005",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "71006",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
